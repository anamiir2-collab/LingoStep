{
  "appId": "com.anamiir2collab.lingostep",
  "appName": "LingoStep",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0f4c81"
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  },
  "backgroundColor": "#f7fafc",
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#1e88e5"
    },
    "TextToSpeech": {
      "speechRate": 1.0
    }
  }
}
